  "repository": {
    "type": "git",
    "url": "git+https://github.com/sipki-tech/scrooge-kit.git"
  },
  "homepage": "https://github.com/sipki-tech/scrooge-kit#readme",
  "bugs": {
    "url": "https://github.com/sipki-tech/scrooge-kit/issues"
  },
  "type": "module",
  "bin": {
    "scrooge-kit": "bin/cli.mjs"
  },
  "files": [
